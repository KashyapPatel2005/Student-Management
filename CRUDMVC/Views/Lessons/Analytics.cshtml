@model List<LessonAnalyticsViewModel>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Lesson Analytics";
    var totalLessons = Model.Count;
    var avgCompletion = Model.Any() ? Math.Round(Model.Average(x => x.Percentage), 1) : 0;
    var topLesson = Model.OrderByDescending(x => x.Percentage).FirstOrDefault();
}

<div style="padding: 0.5rem 0;">

    <div style="width:60vw;margin-bottom: 1.75rem;">
        <h2 style="font-family: 'Syne', sans-serif; font-size: 22px; font-weight: 800; color: var(--text); margin: 0 0 3px;">Lesson Analytics</h2>
        <p style="font-size: 13px; color: var(--text-muted); margin: 0;">Track completion and engagement across all lessons</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-bottom: 1.75rem;">

        <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 1.25rem 1.5rem; display: flex; align-items: center; gap: 14px;">
            <div style="width: 42px; height: 42px; background: var(--accent-soft); border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <i class="fa-solid fa-book" style="color: var(--accent); font-size: 16px;"></i>
            </div>
            <div>
                <p style="font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); margin: 0 0 3px;">Total Lessons</p>
                <p style="font-size: 24px; font-weight: 800; font-family: 'Syne', sans-serif; color: var(--text); margin: 0; line-height: 1;">@totalLessons</p>
            </div>
        </div>

        <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 1.25rem 1.5rem; display: flex; align-items: center; gap: 14px;">
            <div style="width: 42px; height: 42px; background: rgba(52,211,153,0.1); border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <i class="fa-solid fa-chart-line" style="color: var(--success); font-size: 16px;"></i>
            </div>
            <div>
                <p style="font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); margin: 0 0 3px;">Avg Completion</p>
                <p style="font-size: 24px; font-weight: 800; font-family: 'Syne', sans-serif; color: var(--text); margin: 0; line-height: 1;">@avgCompletion<span style="font-size: 14px; color: var(--text-muted);">%</span></p>
            </div>
        </div>

        <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 1.25rem 1.5rem; display: flex; align-items: center; gap: 14px;">
            <div style="width: 42px; height: 42px; background: rgba(248,113,113,0.1); border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <i class="fa-solid fa-trophy" style="color: var(--danger); font-size: 16px;"></i>
            </div>
            <div style="min-width: 0;">
                <p style="font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); margin: 0 0 3px;">Top Lesson</p>
                <p style="font-size: 15px; font-weight: 700; color: var(--text); margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@(topLesson?.Title ?? "—")</p>
            </div>
        </div>

    </div>

    <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 14px; overflow: hidden;">

        <div style="padding: 1.1rem 1.5rem; border-bottom: 1px solid var(--border); display: grid; grid-template-columns: 2fr 1fr 1fr 2fr; gap: 12px;">
            <span style="font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted);">Lesson Title</span>
            <span style="font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted);">Students</span>
            <span style="font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted);">Completed</span>
            <span style="font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted);">Engagement</span>
        </div>

        @foreach (var item in Model)
        {
            var barColor = item.Percentage < 40 ? "var(--danger)" :
            item.Percentage < 75 ? "#f59e0b" : "var(--success)";

            var badgeBg = item.Percentage < 40 ? "rgba(248,113,113,0.12)" :
            item.Percentage < 75 ? "rgba(245,158,11,0.12)" : "rgba(52,211,153,0.12)";

            var badgeColor = item.Percentage < 40 ? "var(--danger)" :
            item.Percentage < 75 ? "#f59e0b" : "var(--success)";

            <div style="padding: 1rem 1.5rem; border-bottom: 1px solid var(--border); display: grid; grid-template-columns: 2fr 1fr 1fr 2fr; gap: 12px; align-items: center; transition: background 0.15s;"
                 onmouseover="this.style.background='var(--surface-2)'"
                 onmouseout="this.style.background='transparent'">

                <div>
                    <p style="font-size: 14px; font-weight: 600; color: var(--text); margin: 0;">@item.Title</p>
                </div>

                <div style="display: flex; align-items: center; gap: 7px;">
                    <i class="fa-solid fa-users" style="font-size: 12px; color: var(--text-muted);"></i>
                    <span style="font-size: 14px; color: var(--text);">@item.TotalUsers</span>
                </div>

                <div>
                    <span style="display: inline-flex; align-items: center; gap: 5px; padding: 4px 10px; background: rgba(79,142,247,0.1); color: var(--accent); border-radius: 6px; font-size: 12.5px; font-weight: 600;">
                        <i class="fa-solid fa-circle-check" style="font-size: 11px;"></i>
                        @item.CompletedUsers
                    </span>
                </div>

                <div style="display: flex; align-items: center; gap: 12px;">
                    <div style="flex: 1; height: 6px; background: var(--surface-2); border-radius: 10px; overflow: hidden;">
                        <div style="width: @(item.Percentage)%; height: 100%; background: @barColor; border-radius: 10px; transition: width 0.4s ease;"></div>
                    </div>
                    <span style="font-size: 13px; font-weight: 700; color: @badgeColor; min-width: 36px; text-align: right;">@item.Percentage%</span>
                </div>

            </div>
        }

    </div>
</div>
