@model CRUDMVC.Models.Entities.Student;

<div style="width:60vw;padding: 0 1rem;">

    <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 16px; overflow: hidden;">

        <div style="padding: 1.75rem 1.75rem 1.5rem; display: flex; align-items: center; gap: 14px;">
            <div style="width: 48px; height: 48px; background: var(--accent); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-family: 'Syne', sans-serif; font-size: 18px; font-weight: 800; color: #fff; box-shadow: 0 0 14px var(--accent-glow); flex-shrink: 0;">
                @Model.Name[0]
            </div>
            <div>
                <p style="font-family: 'Syne', sans-serif; font-size: 17px; font-weight: 800; color: var(--text); margin: 0 0 2px;">@Model.Name</p>
                <p style="font-size: 12.5px; color: var(--text-muted); margin: 0;">Student profile</p>
            </div>
        </div>

        <div style="border-top: 1px solid var(--border); margin: 0 1.75rem;"></div>

        <div style="padding: 1.5rem 1.75rem; display: flex; flex-direction: column; gap: 0;">

            <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid var(--border);">
                <span style="font-size: 12.5px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted);">Student ID</span>
                <span style="font-size: 13.5px; font-weight: 500; color: var(--text);">#@Model.Id</span>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid var(--border);">
                <span style="font-size: 12.5px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted);">Email</span>
                <span style="font-size: 13.5px; font-weight: 500; color: var(--accent);">@Model.Email</span>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 0;">
                <span style="font-size: 12.5px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted);">Phone</span>
                <span style="font-size: 13.5px; font-weight: 500; color: var(--text);">@Model.Phone</span>
            </div>

        </div>

        <div style="border-top: 1px solid var(--border); padding: 1.25rem 1.75rem; display: flex; gap: 10px;">
            <a asp-controller="Students" asp-action="Edit" asp-route-id="@Model.Id"
               style="display: inline-flex; align-items: center; gap: 7px; padding: 9px 20px; background: var(--accent); color: #fff; border-radius: 9px; font-size: 13.5px; font-weight: 600; text-decoration: none; box-shadow: 0 0 12px var(--accent-glow); transition: filter 0.15s;"
               onmouseover="this.style.filter='brightness(1.12)'"
               onmouseout="this.style.filter='none'">
                <i class="fa-solid fa-pen-to-square" style="font-size: 12px;"></i>
                Edit
            </a>
            <a asp-controller="Students" asp-action="List"
               style="display: inline-flex; align-items: center; gap: 7px; padding: 9px 20px; background: transparent; color: var(--text-muted); border: 1px solid var(--border); border-radius: 9px; font-size: 13.5px; font-weight: 500; text-decoration: none; transition: all 0.15s;"
               onmouseover="this.style.background='var(--surface-2)'; this.style.color='var(--text)'"
               onmouseout="this.style.background='transparent'; this.style.color='var(--text-muted)'">
                <i class="fa-solid fa-arrow-left" style="font-size: 12px;"></i>
                Back
            </a>
        </div>

    </div>
</div>