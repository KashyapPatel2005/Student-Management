@model CRUDMVC.Models.LoginViewModel

<div style="display: flex; align-items: center; justify-content: center; padding: 2rem;">
    <div style="width: 100%; max-width: 420px;">

        <div style="text-align: center; margin-bottom: 2rem;">
            <div style="width: 44px; height: 44px; background: var(--accent); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; box-shadow: 0 0 16px var(--accent-glow);">
                <i class="fa-solid fa-graduation-cap" style="color: #fff; font-size: 18px;"></i>
            </div>
            <h2 style="font-family: 'Syne', sans-serif; font-size: 22px; font-weight: 800; color: var(--text); margin: 0 0 6px;">Welcome back</h2>
            <p style="color: var(--text-muted); font-size: 14px; margin: 0;">Sign in to your account to continue</p>
        </div>

        <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 2rem;">

            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger py-2 mb-3"
                     style="display:@(ViewData.ModelState.IsValid ? "none" : "block"); background: rgba(248,113,113,0.1); border: 1px solid rgba(248,113,113,0.25); color: var(--danger); border-radius: 10px;">
                </div>

                <div style="margin-bottom: 1.2rem;">
                    <label asp-for="Email" style="display: block; font-size: 12.5px; font-weight: 600; color: var(--text-muted); letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 7px;"></label>
                    <input asp-for="Email"
                           style="width: 100%; background: var(--surface-2); border: 1px solid var(--border); border-radius: 9px; padding: 10px 14px; font-size: 14px; color: var(--text); outline: none; transition: border-color 0.15s;"
                           placeholder="you@example.com"
                           onfocus="this.style.borderColor='var(--accent)'"
                           onblur="this.style.borderColor='var(--border)'" />
                    <span asp-validation-for="Email" style="font-size: 12px; color: var(--danger); margin-top: 4px; display: block;"></span>
                </div>

                <div style="margin-bottom: 1.5rem;">
                    <label asp-for="Password" style="display: block; font-size: 12.5px; font-weight: 600; color: var(--text-muted); letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 7px;"></label>
                    <input asp-for="Password" type="password"
                           style="width: 100%; background: var(--surface-2); border: 1px solid var(--border); border-radius: 9px; padding: 10px 14px; font-size: 14px; color: var(--text); outline: none; transition: border-color 0.15s;"
                           placeholder="••••••••"
                           onfocus="this.style.borderColor='var(--accent)'"
                           onblur="this.style.borderColor='var(--border)'" />
                    <span asp-validation-for="Password" style="font-size: 12px; color: var(--danger); margin-top: 4px; display: block;"></span>
                </div>

                <button type="submit"
                        style="width: 100%; background: var(--accent); color: #fff; border: none; border-radius: 9px; padding: 11px; font-size: 14.5px; font-weight: 600; cursor: pointer; box-shadow: 0 0 14px var(--accent-glow); transition: filter 0.15s; margin-bottom: 10px;"
                        onmouseover="this.style.filter='brightness(1.12)'"
                        onmouseout="this.style.filter='none'">
                    Sign in
                </button>

                <div style="display: flex; align-items: center; gap: 10px; margin: 14px 0;">
                    <div style="flex: 1; height: 1px; background: var(--border);"></div>
                    <span style="font-size: 12px; color: var(--text-muted);">or</span>
                    <div style="flex: 1; height: 1px; background: var(--border);"></div>
                </div>

                <a asp-controller="Account" asp-action="GoogleLogin"
                   style="display: flex; align-items: center; justify-content: center; gap: 9px; width: 100%; background: transparent; border: 1px solid var(--border); border-radius: 9px; padding: 10px; font-size: 14px; font-weight: 500; color: var(--text); text-decoration: none; transition: all 0.15s;"
                   onmouseover="this.style.background='var(--surface-2)'; this.style.borderColor='rgba(255,255,255,0.14)'"
                   onmouseout="this.style.background='transparent'; this.style.borderColor='var(--border)'">
                    <svg width="16" height="16" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
                    </svg>
                    Continue with Google
                </a>
            </form>
        </div>

        <p style="text-align: center; margin-top: 1.25rem; font-size: 13.5px; color: var(--text-muted);">
            New here?
            <a asp-controller="Account" asp-action="Register"
               style="color: var(--accent); text-decoration: none; font-weight: 500;">
                Create an account
            </a>
        </p>
    </div>
</div>