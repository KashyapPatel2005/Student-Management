@model CRUDMVC.Models.RegisterViewModel

<div style="display: flex; align-items: center; justify-content: center; padding: 2rem;">
    <div style="width: 100%; max-width: 420px;">

        <div style="text-align: center; margin-bottom: 2rem;">
            <div style="width: 44px; height: 44px; background: var(--accent); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; box-shadow: 0 0 16px var(--accent-glow);">
                <i class="fa-solid fa-user-plus" style="color: #fff; font-size: 16px;"></i>
            </div>
            <h2 style="font-family: 'Syne', sans-serif; font-size: 22px; font-weight: 800; color: var(--text); margin: 0 0 6px;">Create an account</h2>
            <p style="color: var(--text-muted); font-size: 14px; margin: 0;">Fill in your details to get started</p>
        </div>

        <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 2rem;">
            <form asp-action="Register" method="post">

                <div asp-validation-summary="All"
                     class="mb-3"
                     style="display:@(ViewData.ModelState.IsValid ? "none" : "block"); background: rgba(248,113,113,0.1); border: 1px solid rgba(248,113,113,0.25); color: var(--danger); border-radius: 10px; padding: 10px 14px; font-size: 13px;">
                </div>

                <div style="margin-bottom: 1.2rem;">
                    <label asp-for="Email" style="display: block; font-size: 12.5px; font-weight: 600; color: var(--text-muted); letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 7px;"></label>
                    <input asp-for="Email"
                           placeholder="you@example.com"
                           style="width: 100%; background: var(--surface-2); border: 1px solid var(--border); border-radius: 9px; padding: 10px 14px; font-size: 14px; color: var(--text); outline: none; transition: border-color 0.15s;"
                           onfocus="this.style.borderColor='var(--accent)'"
                           onblur="this.style.borderColor='var(--border)'" />
                    <span asp-validation-for="Email" style="font-size: 12px; color: var(--danger); margin-top: 4px; display: block;"></span>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 1.5rem;">
                    <div>
                        <label asp-for="Password" style="display: block; font-size: 12.5px; font-weight: 600; color: var(--text-muted); letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 7px;"></label>
                        <input asp-for="Password" type="password"
                               placeholder="••••••••"
                               style="width: 100%; background: var(--surface-2); border: 1px solid var(--border); border-radius: 9px; padding: 10px 14px; font-size: 14px; color: var(--text); outline: none; transition: border-color 0.15s;"
                               onfocus="this.style.borderColor='var(--accent)'"
                               onblur="this.style.borderColor='var(--border)'" />
                        <span asp-validation-for="Password" style="font-size: 12px; color: var(--danger); margin-top: 4px; display: block;"></span>
                    </div>
                    <div>
                        <label asp-for="ConfirmPassword" style="display: block; font-size: 12.5px; font-weight: 600; color: var(--text-muted); letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 7px;"></label>
                        <input asp-for="ConfirmPassword" type="password"
                               placeholder="••••••••"
                               style="width: 100%; background: var(--surface-2); border: 1px solid var(--border); border-radius: 9px; padding: 10px 14px; font-size: 14px; color: var(--text); outline: none; transition: border-color 0.15s;"
                               onfocus="this.style.borderColor='var(--accent)'"
                               onblur="this.style.borderColor='var(--border)'" />
                        <span asp-validation-for="ConfirmPassword" style="font-size: 12px; color: var(--danger); margin-top: 4px; display: block;"></span>
                    </div>
                </div>

                <button type="submit"
                        style="width: 100%; background: var(--accent); color: #fff; border: none; border-radius: 9px; padding: 11px; font-size: 14.5px; font-weight: 600; cursor: pointer; box-shadow: 0 0 14px var(--accent-glow); transition: filter 0.15s;"
                        onmouseover="this.style.filter='brightness(1.12)'"
                        onmouseout="this.style.filter='none'">
                    Create account
                </button>

            </form>
        </div>

        <p style="text-align: center; margin-top: 1.25rem; font-size: 13.5px; color: var(--text-muted);">
            Already a member?
            <a asp-controller="Account" asp-action="Login"
               style="color: var(--accent); text-decoration: none; font-weight: 500;">
                Sign in
            </a>
        </p>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}