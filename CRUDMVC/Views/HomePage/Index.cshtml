

<div style="display: flex; align-items: center; justify-content: center; padding: 2rem;">
    <div style="width: 100%; max-width: 420px; text-align: center;">

        <div style="width: 52px; height: 52px; background: var(--accent); border-radius: 14px; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; box-shadow: 0 0 20px var(--accent-glow);">
            <i class="fa-solid fa-graduation-cap" style="color: #fff; font-size: 20px;"></i>
        </div>

        <h1 style="font-family: 'Syne', sans-serif; font-size: 28px; font-weight: 800; color: var(--text); margin: 0 0 10px; letter-spacing: -0.5px;">Student Portal</h1>
        <p style="color: var(--text-muted); font-size: 14.5px; line-height: 1.6; margin: 0 auto 2.5rem; max-width: 300px;">
            Manage your academic journey with ease. Sign in to access your dashboard.
        </p>

        <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 1.75rem; display: flex; flex-direction: column; gap: 10px; margin-bottom: 1.5rem;">

            <a asp-controller="Account" asp-action="Login"
               style="display: flex; align-items: center; justify-content: center; gap: 9px; width: 100%; background: var(--accent); color: #fff; border: none; border-radius: 9px; padding: 12px; font-size: 14.5px; font-weight: 600; text-decoration: none; box-shadow: 0 0 14px var(--accent-glow); transition: filter 0.15s;"
               onmouseover="this.style.filter='brightness(1.12)'"
               onmouseout="this.style.filter='none'">
                <i class="fa-solid fa-arrow-right-to-bracket" style="font-size: 13px;"></i>
                Login to account
            </a>

            <a asp-controller="Account" asp-action="Register"
               style="display: flex; align-items: center; justify-content: center; gap: 9px; width: 100%; background: transparent; color: var(--text); border: 1px solid var(--border); border-radius: 9px; padding: 12px; font-size: 14.5px; font-weight: 500; text-decoration: none; transition: all 0.15s;"
               onmouseover="this.style.background='var(--surface-2)'; this.style.borderColor='rgba(255,255,255,0.14)'"
               onmouseout="this.style.background='transparent'; this.style.borderColor='var(--border)'">
                <i class="fa-solid fa-user-plus" style="font-size: 13px;"></i>
                Create new account
            </a>
        </div>

        <p style="font-size: 12.5px; color: var(--text-muted); margin: 0;">
            &copy; 2026 Student Management System
        </p>

    </div>
</div>