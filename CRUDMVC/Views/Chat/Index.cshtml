@{
    Layout = "_DashboardLayout";
    var currentUser = User.Identity.Name;
    var isAdmin = User.IsInRole("Admin");
}

<style>
    .chat-container {
        height: 70vh;
        display: flex;
        flex-direction: column;
    }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
        background: #f1f3f6;
        border-radius: 12px;
    }

    .message-row {
        display: flex;
        margin-bottom: 15px;
    }

    .message-left {
        justify-content: flex-start;
    }

    .message-right {
        justify-content: flex-end;
    }

    .message-bubble {
        max-width: 60%;
        padding: 12px 16px;
        border-radius: 18px;
        position: relative;
        font-size: 14px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .bubble-left {
        background: white;
        border-top-left-radius: 4px;
    }

    .bubble-right {
        background: #0d6efd;
        color: white;
        border-top-right-radius: 4px;
    }

    .username-label {
        font-size: 11px;
        margin-top: 4px;
        opacity: 0.7;
    }

    .chat-input {
        margin-top: 15px;
    }

    .admin-badge {
        background: #dc3545;
        color: white;
        font-size: 10px;
        padding: 2px 6px;
        border-radius: 6px;
        margin-left: 5px;
    }
</style>

<div class="card shadow p-4 chat-container">
    <h4 class="mb-3">🌍 Global Chat Room</h4>

    <div id="chatBox" class="chat-messages"></div>

    <div class="input-group chat-input">
        <input type="text"
               id="messageInput"
               class="form-control"
               placeholder="Type your message..." />
        <button class="btn btn-primary"
                onclick="sendMessage()">
            Send
        </button>
    </div>
</div>

@section Scripts {

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    <script>

        const currentUser = "@currentUser";
        const isAdmin = "@isAdmin" === "True";

        // Load old messages
        window.onload = function () {
            fetch("/Chat/GetMessages")
                .then(res => res.json())
                .then(data => {
                    data.forEach(msg => {
                        renderMessage(msg.username, msg.message);
                    });
                });
        };

        function renderMessage(username, message) {

            const chatBox = document.getElementById("chatBox");

            const isMine = username === currentUser ||
                           (isAdmin && username === "Admin");

            const rowClass = isMine ? "message-row message-right"
                                    : "message-row message-left";

            const bubbleClass = isMine ? "message-bubble bubble-right"
                                       : "message-bubble bubble-left";

            const adminBadge = username === "Admin"
                ? `<span class="admin-badge">ADMIN</span>`
                : "";

            chatBox.innerHTML += `
                <div class="${rowClass}">
                    <div>
                        <div class="${bubbleClass}">
                            ${message}
                        </div>
                        <div class="username-label">
                            ${username} ${adminBadge}
                        </div>
                    </div>
                </div>
            `;

            chatBox.scrollTop = chatBox.scrollHeight;
        }

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/chat")
            .build();

        connection.on("ReceiveMessage", function (username, message) {
            renderMessage(username, message);
        });

        connection.start();

        function sendMessage() {

            const input = document.getElementById("messageInput");
            const message = input.value;

            if (!message.trim()) return;

            connection.invoke("SendMessage", message);

            fetch("/Chat/SaveMessage", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: `message=${message}`
            });

            input.value = "";
        }

    </script>
}