@{
    Layout = "_DashboardLayout";
    var currentUser = User.Identity.Name;
    var isAdmin = User.IsInRole("Admin");
}

<div style="padding: 0.5rem 0;">

    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 1.25rem;">
        <div style="width: 38px; height: 38px; background: var(--accent); border-radius: 10px; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 12px var(--accent-glow); flex-shrink: 0;">
            <i class="fa-solid fa-comments" style="color: #fff; font-size: 15px;"></i>
        </div>
        <div>
            <h2 style="font-family: 'Syne', sans-serif; font-size: 20px; font-weight: 800; color: var(--text); margin: 0 0 2px;">Chat Room</h2>
            <p style="font-size: 12.5px; color: var(--text-muted); margin: 0;">Live messaging</p>
        </div>
    </div>

    <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 16px; overflow: hidden; display: flex; flex-direction: column;">

        <div style="padding: 10px 16px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 8px;">
            <div style="width: 8px; height: 8px; background: var(--success); border-radius: 50%; box-shadow: 0 0 6px var(--success);"></div>
            <span style="font-size: 12.5px; color: var(--text-muted);">Connected</span>
        </div>

        <div id="chatBox"
             style="height: 500px; overflow-y: auto; padding: 1.25rem; display: flex; flex-direction: column; gap: 12px; scroll-behavior: smooth;">
        </div>

        <div style="border-top: 1px solid var(--border); padding: 1rem 1.25rem; display: flex; gap: 10px; align-items: center;">
            <input type="text"
                   id="messageInput"
                   placeholder="Type a message..."
                   style="flex: 1; background: var(--surface-2); border: 1px solid var(--border); border-radius: 50px; padding: 10px 18px; font-size: 14px; color: var(--text); outline: none; transition: border-color 0.15s;"
                   onfocus="this.style.borderColor='var(--accent)'"
                   onblur="this.style.borderColor='var(--border)'"
                   onkeydown="if(event.key === 'Enter') sendMessage()" />
            <button onclick="sendMessage()"
                    style="width: 40px; height: 40px; background: var(--accent); border: none; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: 0 0 10px var(--accent-glow); transition: filter 0.15s; flex-shrink: 0;"
                    onmouseover="this.style.filter='brightness(1.15)'"
                    onmouseout="this.style.filter='none'">
                <i class="fa-solid fa-paper-plane" style="color: #fff; font-size: 13px;"></i>
            </button>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        const currentUser = "@currentUser";
        const isAdmin = "@isAdmin" === "True";

        window.onload = function () {
            fetch("/Chat/GetMessages")
                .then(res => res.json())
                .then(data => {
                    data.forEach(msg => {
                        renderMessage(msg.username, msg.message);
                    });
                });
        };

        function renderMessage(username, message) {
            const chatBox = document.getElementById("chatBox");
            const isMine = username === currentUser;
            const isAdminUser = username === "Admin";
            const initial = username.charAt(0).toUpperCase();

            const adminBadge = isAdminUser
                ? `<span style="font-size:10px;font-weight:700;background:rgba(248,113,113,0.15);color:var(--danger);border:1px solid rgba(248,113,113,0.3);border-radius:4px;padding:1px 6px;letter-spacing:0.04em;margin-left:6px;">ADMIN</span>`
                : "";

            const wrapper = document.createElement("div");
            wrapper.style.cssText = `display:flex; justify-content:${isMine ? "flex-end" : "flex-start"};`;

            if (isMine) {
                wrapper.innerHTML = `
                    <div style="max-width:72%;display:flex;flex-direction:column;align-items:flex-end;gap:4px;">
                        <div style="font-size:11.5px;color:var(--text-muted);padding-right:6px;">${username}</div>
                        <div style="background:var(--accent);color:#fff;border-radius:16px 16px 4px 16px;padding:10px 14px;font-size:13.5px;line-height:1.5;box-shadow:0 0 10px var(--accent-glow);">
                            ${message}
                        </div>
                    </div>`;
            } else {
                wrapper.innerHTML = `
                    <div style="max-width:72%;display:flex;gap:9px;align-items:flex-end;">
                        <div style="width:30px;height:30px;background:var(--surface-2);border:1px solid var(--border);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:var(--text-muted);flex-shrink:0;">${initial}</div>
                        <div style="display:flex;flex-direction:column;gap:4px;">
                            <div style="font-size:11.5px;color:var(--text-muted);padding-left:4px;display:flex;align-items:center;">${username}${adminBadge}</div>
                            <div style="background:var(--surface-2);border:1px solid var(--border);color:var(--text);border-radius:16px 16px 16px 4px;padding:10px 14px;font-size:13.5px;line-height:1.5;">
                                ${message}
                            </div>
                        </div>
                    </div>`;
            }

            chatBox.appendChild(wrapper);
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/chat")
            .build();

        connection.on("ReceiveMessage", function (username, message) {
            renderMessage(username, message);
        });

        connection.start();

        function sendMessage() {
            const input = document.getElementById("messageInput");
            const message = input.value;
            connection.invoke("SendMessage", message);
            fetch("/Chat/SaveMessage", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: `message=${message}`
            });
            input.value = "";
        }
    </script>
}