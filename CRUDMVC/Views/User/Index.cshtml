
@model EditProfileViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "My Profile";
}

@if (!ViewData.ModelState.IsValid)
{
    <div style="background: rgba(248,113,113,0.1); border: 1px solid rgba(248,113,113,0.25); color: var(--danger); border-radius: 10px; padding: 12px 16px; font-size: 13.5px; margin-bottom: 1.25rem;">
        <i class="fa-solid fa-circle-exclamation" style="margin-right: 8px;"></i>
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}

@if (TempData["Success"] != null)
{
    <div style="background: rgba(52,211,153,0.1); border: 1px solid rgba(52,211,153,0.25); color: var(--success); border-radius: 10px; padding: 12px 16px; font-size: 13.5px; margin-bottom: 1.25rem;">
        <i class="fa-solid fa-circle-check" style="margin-right: 8px;"></i>
        @TempData["Success"]
    </div>
}

<div style="padding: 0.5rem 0;">

    <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 16px; overflow: hidden; margin-bottom: 1.5rem;">

        <div style="padding: 2rem; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 18px; background: var(--surface-2);">
            <div style="width: 60px; height: 60px; background: var(--accent); border-radius: 14px; display: flex; align-items: center; justify-content: center; font-family: 'Syne', sans-serif; font-size: 24px; font-weight: 800; color: #fff; box-shadow: 0 0 18px var(--accent-glow); flex-shrink: 0;">
                @Model.UserName?.ToUpper().FirstOrDefault()
            </div>
            <div>
                <h4 style="font-family: 'Syne', sans-serif; font-size: 18px; font-weight: 800; color: var(--text); margin: 0 0 4px;">@Model.UserName</h4>
                <span style="font-size: 12.5px; color: var(--text-muted);">Registered User</span>
            </div>
        </div>

        <div style="padding: 1.75rem;">

            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-bottom: 1.75rem;">

                <div style="background: var(--surface-2); border: 1px solid var(--border); border-radius: 12px; padding: 1rem 1.25rem;">
                    <p style="font-size: 11.5px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin: 0 0 6px;">Username</p>
                    <p style="font-size: 14px; font-weight: 600; color: var(--text); margin: 0;">@Model.UserName</p>
                </div>

                <div style="background: var(--surface-2); border: 1px solid var(--border); border-radius: 12px; padding: 1rem 1.25rem;">
                    <p style="font-size: 11.5px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin: 0 0 6px;">Email Address</p>
                    <p style="font-size: 14px; font-weight: 600; color: var(--accent); margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@Model.Email</p>
                </div>

                <div style="background: var(--surface-2); border: 1px solid var(--border); border-radius: 12px; padding: 1rem 1.25rem;">
                    <p style="font-size: 11.5px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin: 0 0 6px;">Role</p>
                    <span style="display: inline-flex; align-items: center; gap: 5px; padding: 3px 10px; background: var(--accent-soft); color: var(--accent); border-radius: 6px; font-size: 12.5px; font-weight: 600;">
                        <i class="fa-solid fa-shield-halved" style="font-size: 11px;"></i>
                        @(User.IsInRole("Admin") ? "Administrator" : "User")
                    </span>
                </div>

            </div>

            <div style="display: flex; gap: 10px;">
                <button data-bs-toggle="modal" data-bs-target="#editProfileModal"
                        style="display: inline-flex; align-items: center; gap: 7px; padding: 10px 20px; background: var(--accent); color: #fff; border: none; border-radius: 9px; font-size: 13.5px; font-weight: 600; cursor: pointer; box-shadow: 0 0 12px var(--accent-glow); transition: filter 0.15s;"
                        onmouseover="this.style.filter='brightness(1.12)'"
                        onmouseout="this.style.filter='none'">
                    <i class="fa-solid fa-pen-to-square" style="font-size: 12px;"></i>
                    Edit Profile
                </button>

                <button data-bs-toggle="modal" data-bs-target="#changePasswordModal"
                        style="display: inline-flex; align-items: center; gap: 7px; padding: 10px 20px; background: transparent; color: var(--text-muted); border: 1px solid var(--border); border-radius: 9px; font-size: 13.5px; font-weight: 500; cursor: pointer; transition: all 0.15s;"
                        onmouseover="this.style.background='var(--surface-2)'; this.style.color='var(--text)'"
                        onmouseout="this.style.background='transparent'; this.style.color='var(--text-muted)'">
                    <i class="fa-solid fa-lock" style="font-size: 12px;"></i>
                    Change Password
                </button>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="editProfileModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: var(--surface); border: 1px solid var(--border); border-radius: 16px; overflow: hidden;">
            <form asp-controller="User" asp-action="UpdateProfile" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-header" style="border-bottom: 1px solid var(--border); padding: 1.25rem 1.5rem;">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <div style="width: 32px; height: 32px; background: var(--accent-soft); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                            <i class="fa-solid fa-pen-to-square" style="color: var(--accent); font-size: 13px;"></i>
                        </div>
                        <h5 class="modal-title" style="font-family: 'Syne', sans-serif; font-size: 16px; font-weight: 800; color: var(--text); margin: 0;">Edit Profile</h5>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" style="filter: invert(1) opacity(0.4);"></button>
                </div>

                <div class="modal-body" style="padding: 1.5rem;">
                    <div style="margin-bottom: 1.2rem;">
                        <label style="display: block; font-size: 12.5px; font-weight: 600; color: var(--text-muted); letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 7px;">Username</label>
                        <input asp-for="UserName" placeholder="Enter username"
                               style="width: 100%; background: var(--surface-2); border: 1px solid var(--border); border-radius: 9px; padding: 10px 14px; font-size: 14px; color: var(--text); outline: none; transition: border-color 0.15s;"
                               onfocus="this.style.borderColor='var(--accent)'"
                               onblur="this.style.borderColor='var(--border)'" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 12.5px; font-weight: 600; color: var(--text-muted); letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 7px;">Email</label>
                        <input asp-for="Email" placeholder="Enter email address"
                               style="width: 100%; background: var(--surface-2); border: 1px solid var(--border); border-radius: 9px; padding: 10px 14px; font-size: 14px; color: var(--text); outline: none; transition: border-color 0.15s;"
                               onfocus="this.style.borderColor='var(--accent)'"
                               onblur="this.style.borderColor='var(--border)'" />
                    </div>
                </div>

                <div class="modal-footer" style="border-top: 1px solid var(--border); padding: 1rem 1.5rem; gap: 10px; justify-content: flex-end;">
                    <button type="button" data-bs-dismiss="modal"
                            style="padding: 9px 20px; background: transparent; border: 1px solid var(--border); border-radius: 9px; font-size: 13.5px; font-weight: 500; color: var(--text-muted); cursor: pointer; transition: all 0.15s;"
                            onmouseover="this.style.background='var(--surface-2)'"
                            onmouseout="this.style.background='transparent'">
                        Cancel
                    </button>
                    <button type="submit"
                            style="padding: 9px 20px; background: var(--accent); border: none; border-radius: 9px; font-size: 13.5px; font-weight: 600; color: #fff; cursor: pointer; box-shadow: 0 0 10px var(--accent-glow); transition: filter 0.15s;"
                            onmouseover="this.style.filter='brightness(1.12)'"
                            onmouseout="this.style.filter='none'">
                        Save changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="changePasswordModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: var(--surface); border: 1px solid var(--border); border-radius: 16px; overflow: hidden;">
            <form asp-controller="User" asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-header" style="border-bottom: 1px solid var(--border); padding: 1.25rem 1.5rem;">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <div style="width: 32px; height: 32px; background: rgba(248,113,113,0.12); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                            <i class="fa-solid fa-lock" style="color: var(--danger); font-size: 13px;"></i>
                        </div>
                        <h5 class="modal-title" style="font-family: 'Syne', sans-serif; font-size: 16px; font-weight: 800; color: var(--text); margin: 0;">Change Password</h5>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" style="filter: invert(1) opacity(0.4);"></button>
                </div>

                <div class="modal-body" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
                    <div>
                        <label style="display: block; font-size: 12.5px; font-weight: 600; color: var(--text-muted); letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 7px;">Current Password</label>
                        <input name="currentPassword" type="password" required placeholder="••••••••"
                               style="width: 100%; background: var(--surface-2); border: 1px solid var(--border); border-radius: 9px; padding: 10px 14px; font-size: 14px; color: var(--text); outline: none; transition: border-color 0.15s;"
                               onfocus="this.style.borderColor='var(--accent)'"
                               onblur="this.style.borderColor='var(--border)'" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 12.5px; font-weight: 600; color: var(--text-muted); letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 7px;">New Password</label>
                        <input name="newPassword" type="password" required placeholder="••••••••"
                               style="width: 100%; background: var(--surface-2); border: 1px solid var(--border); border-radius: 9px; padding: 10px 14px; font-size: 14px; color: var(--text); outline: none; transition: border-color 0.15s;"
                               onfocus="this.style.borderColor='var(--accent)'"
                               onblur="this.style.borderColor='var(--border)'" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 12.5px; font-weight: 600; color: var(--text-muted); letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 7px;">Confirm Password</label>
                        <input name="confirmPassword" type="password" required placeholder="••••••••"
                               style="width: 100%; background: var(--surface-2); border: 1px solid var(--border); border-radius: 9px; padding: 10px 14px; font-size: 14px; color: var(--text); outline: none; transition: border-color 0.15s;"
                               onfocus="this.style.borderColor='var(--accent)'"
                               onblur="this.style.borderColor='var(--border)'" />
                    </div>
                </div>

                <div class="modal-footer" style="border-top: 1px solid var(--border); padding: 1rem 1.5rem; gap: 10px; justify-content: flex-end;">
                    <button type="button" data-bs-dismiss="modal"
                            style="padding: 9px 20px; background: transparent; border: 1px solid var(--border); border-radius: 9px; font-size: 13.5px; font-weight: 500; color: var(--text-muted); cursor: pointer; transition: all 0.15s;"
                            onmouseover="this.style.background='var(--surface-2)'"
                            onmouseout="this.style.background='transparent'">
                        Cancel
                    </button>
                    <button type="submit"
                            style="padding: 9px 20px; background: var(--accent); border: none; border-radius: 9px; font-size: 13.5px; font-weight: 600; color: #fff; cursor: pointer; box-shadow: 0 0 10px var(--accent-glow); transition: filter 0.15s;"
                            onmouseover="this.style.filter='brightness(1.12)'"
                            onmouseout="this.style.filter='none'">
                        Update password
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>