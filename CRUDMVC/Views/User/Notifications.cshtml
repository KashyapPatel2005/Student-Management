@model List<Notification>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Notifications";
}

<div style="padding: 1rem;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
        <h3 style="margin:0;">Notifications</h3>
        <a asp-controller="User" asp-action="Notifications" class="btn btn-sm btn-outline-secondary">Refresh</a>
    </div>

    @if (!Model.Any())
    {
        <div style="padding:1rem; background:var(--surface); border-radius:8px; border:1px solid var(--border);">No notifications available.</div>
    }
    else
    {
        <div style="display:flex; flex-direction:column; gap:10px;">
            @foreach (var n in Model)
            {
                <div style="background:var(--surface); border:1px solid var(--border); padding:12px; border-radius:10px; display:flex; justify-content:space-between; align-items:center;">
                    <div>
                        <div style="font-weight:700;">@n.Title</div>
                        <div style="color:var(--text-muted); font-size:0.9rem;">@n.Description</div>
                        <div style="color:var(--text-secondary); font-size:0.8rem; margin-top:6px;">@n.CreatedAt.ToString("g")</div>
                    </div>
                    <div style="display:flex; gap:8px; align-items:center;">
                        @if (!string.IsNullOrEmpty(n.FilePath))
                        {
                            <a asp-action="DownloadNotification" asp-route-id="@n.Id" class="btn btn-sm btn-primary">Download</a>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No attachment</span>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>