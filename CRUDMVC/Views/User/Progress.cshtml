@{
    Layout = "_DashboardLayout";
}

<div class="container-fluid px-4 px-lg-5 py-4">

    <!-- Header -->
    <div class="mb-4">
        <h3 class="fw-bold mb-0">Progress Overview</h3>
        <p class="text-muted">Visual representation of your learning progress.</p>
    </div>

    <div class="row g-4">

        <!-- Chart Card -->
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">

                    <h6 class="fw-semibold mb-3">
                        Lesson Completion Chart
                    </h6>

                    <canvas id="progressChart" height="250"></canvas>

                </div>
            </div>
        </div>

        <!-- Summary Card -->
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">

                    <h6 class="fw-semibold mb-3">
                        Summary
                    </h6>

                    <p><strong>Total Lessons:</strong> @ViewBag.TotalLessons</p>
                    <p class="text-success">
                        <strong>Completed:</strong> @ViewBag.Completed
                    </p>
                    <p class="text-warning">
                        <strong>Pending:</strong> @ViewBag.Pending
                    </p>
                    <p class="text-primary">
                        <strong>Completion:</strong> @ViewBag.Percentage%
                    </p>

                </div>
            </div>
        </div>

    </div>

</div>

<!-- Chart Script -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const ctx = document.getElementById('progressChart');

    new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: ['Completed', 'Pending'],
            datasets: [{
                data: [
                    @ViewBag.Completed,
                    @ViewBag.Pending
                ],
                backgroundColor: [
                    '#198754', // green
                    '#ffc107'  // yellow
                ],
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    position: 'bottom'
                }
            }
        }
    });
</script>




