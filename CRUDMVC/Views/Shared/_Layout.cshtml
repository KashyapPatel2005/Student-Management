
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    bool isAuthenticated = User.Identity.IsAuthenticated;
    bool isAdmin = User.IsInRole("Admin");
    bool isUser = User.IsInRole("User");

    bool showAdminSidebar = isAuthenticated && isAdmin;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Student Portal</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CRUDMVC.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Syne:wght@700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #0d0f14;
            --surface: #13161d;
            --surface-2: #1b1f29;
            --border: rgba(255,255,255,0.07);
            --accent: #4f8ef7;
            --accent-glow: rgba(79,142,247,0.18);
            --accent-soft: rgba(79,142,247,0.10);
            --text: #e8eaf0;
            --text-muted: #6b7280;
            --danger: #f87171;
            --success: #34d399;
            --sidebar-w: 230px;
            --nav-h: 60px;
            --radius: 10px;
            --transition: 0.18s ease;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            height: 100%;
            background: var(--bg);
            color: var(--text);
            font-family: 'DM Sans', sans-serif;
            font-size: 14.5px;
            -webkit-font-smoothing: antialiased;
            overflow-y: hidden;
        }

        .sp-nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: var(--nav-h);
            background: rgba(13,15,20,0.85);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            padding: 0 24px;
            z-index: 1000;
            gap: 16px;
        }

        .sp-nav__brand {
            font-family: 'Syne', sans-serif;
            font-size: 18px;
            font-weight: 800;
            letter-spacing: -0.3px;
            color: var(--text);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .sp-nav__brand-icon {
            width: 30px;
            height: 30px;
            background: var(--accent);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            color: #fff;
            box-shadow: 0 0 12px var(--accent-glow);
            flex-shrink: 0;
        }

        .sp-nav__actions {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .btn-sp {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 7px 16px;
            border-radius: 8px;
            font-size: 13.5px;
            font-weight: 500;
            border: none;
            cursor: pointer;
            transition: all var(--transition);
            text-decoration: none;
            line-height: 1;
        }

        .btn-sp-ghost {
            background: transparent;
            color: var(--text-muted);
            border: 1px solid var(--border);
        }

            .btn-sp-ghost:hover {
                background: var(--surface-2);
                color: var(--text);
                border-color: rgba(255,255,255,0.14);
            }

        .btn-sp-primary {
            background: var(--accent);
            color: #fff;
            box-shadow: 0 0 14px var(--accent-glow);
        }

            .btn-sp-primary:hover {
                filter: brightness(1.12);
                box-shadow: 0 0 20px var(--accent-glow);
            }

        .user-pill {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 5px 12px 5px 5px;
            border-radius: 50px;
            background: var(--surface-2);
            border: 1px solid var(--border);
            cursor: pointer;
            transition: all var(--transition);
            text-decoration: none;
            color: var(--text);
        }

            .user-pill:hover {
                border-color: rgba(255,255,255,0.14);
                background: #222636;
                color: var(--text);
            }

        .user-avatar {
            width: 28px;
            height: 28px;
            background: var(--accent);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 11px;
            color: #fff;
            flex-shrink: 0;
            box-shadow: 0 0 8px var(--accent-glow);
        }

        .user-name {
            font-size: 13px;
            font-weight: 500;
        }

        .dropdown-menu {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            box-shadow: 0 16px 48px rgba(0,0,0,0.5);
            padding: 6px;
            min-width: 180px;
        }

        .dropdown-item {
            color: var(--text-muted);
            border-radius: 7px;
            padding: 8px 12px;
            font-size: 13.5px;
            font-weight: 500;
            transition: all var(--transition);
            display: flex;
            align-items: center;
            gap: 8px;
            background: none;
            border: none;
            width: 100%;
            cursor: pointer;
        }

            .dropdown-item:hover {
                background: var(--surface-2);
                color: var(--text);
            }

            .dropdown-item.text-danger {
                color: var(--danger) !important;
            }

                .dropdown-item.text-danger:hover {
                    background: rgba(248,113,113,0.1);
                }

        .dropdown-divider {
            border-color: var(--border);
            margin: 4px 0;
        }

        .sp-sidebar {
            position: fixed;
            top: var(--nav-h);
            left: 0;
            width: var(--sidebar-w);
            height: calc(100vh - var(--nav-h));
            background: var(--surface);
            border-right: 1px solid var(--border);
            padding: 20px 12px;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            z-index: 900;
        }

        .sidebar-section-label {
            font-size: 10.5px;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--text-muted);
            padding: 0 8px;
            margin: 4px 0 6px;
        }

        .sidebar-nav {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

            .sidebar-nav a {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 9px 12px;
                border-radius: 8px;
                color: var(--text-muted);
                text-decoration: none;
                font-weight: 500;
                font-size: 13.5px;
                transition: all var(--transition);
                position: relative;
            }

                .sidebar-nav a:hover {
                    background: var(--surface-2);
                    color: var(--text);
                }

                .sidebar-nav a.active {
                    background: var(--accent-soft);
                    color: var(--accent);
                    border: 1px solid rgba(79,142,247,0.2);
                }

                    .sidebar-nav a.active .nav-icon {
                        color: var(--accent);
                    }

        .nav-icon {
            width: 18px;
            text-align: center;
            font-size: 13px;
            flex-shrink: 0;
        }

        .sidebar-divider {
            border-color: var(--border);
            margin: 12px 0;
        }

        .sp-layout {
            padding-top: var(--nav-h);
            min-height: 100vh;
        }

        .sp-layout--sidebar {
            display: flex;
        }

        .sp-main {
            flex: 1;
            margin-left: var(--sidebar-w);
            padding: 28px 32px;
            min-height: calc(100vh - var(--nav-h));
        }

        .sp-main--full {
            max-width: 100vw;
            margin: 0 auto;
            padding: 40px 24px;
        }

        .alert-success {
            background: rgba(52,211,153,0.1);
            border: 1px solid rgba(52,211,153,0.25);
            color: var(--success);
            border-radius: var(--radius);
        }

        .btn-close {
            filter: invert(1) opacity(0.5);
        }

        .sp-footer {
            border-top: 1px solid var(--border);
            padding: 20px 32px;
            text-align: center;
            color: var(--text-muted);
            font-size: 13px;
        }
    </style>
</head>

<body>
    <nav class="sp-nav">
        <a asp-controller="Home" asp-action="Index" class="sp-nav__brand">
            <div class="sp-nav__brand-icon">
                <i class="fa-solid fa-graduation-cap"></i>
            </div>
            Student Portal
        </a>

        <div class="sp-nav__actions">
            @if (!isAuthenticated)
            {
                <a asp-controller="Account" asp-action="Register" class="btn-sp btn-sp-ghost">
                    Register
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn-sp btn-sp-primary">
                    <i class="fa-solid fa-arrow-right-to-bracket" style="font-size:12px;"></i>
                    Login
                </a>
            }
            else
            {
                <div class="dropdown">
                    <a href="#" class="user-pill dropdown-toggle"
                       id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="user-avatar">
                            @User.Identity?.Name?.ToUpper().FirstOrDefault()
                        </div>
                        <span class="user-name d-none d-sm-inline">@User.Identity?.Name</span>
                        <i class="fa-solid fa-chevron-down" style="font-size:10px; color: var(--text-muted);"></i>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                        <li>
                            <span class="dropdown-item" style="color:var(--text-muted); font-size:12px; cursor:default;">
                                Signed in as <strong style="color:var(--text);">@User.Identity?.Name</strong>
                            </span>
                        </li>
                        <li>
                            <a class="dropdown-item" asp-controller="User" asp-action="Index">
                                <i class="fa-solid fa-user"></i>
                                Profile
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" asp-controller="User" asp-action="Notifications">
                                <i class="fa-solid fa-bell"></i>
                                Notifications
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="fa-solid fa-right-from-bracket"></i>
                                    Sign out
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
        </div>
    </nav>

    <div class="sp-layout @(showAdminSidebar ? "sp-layout--sidebar" : "")">

        @if (showAdminSidebar)
        {
            <aside class="sp-sidebar">

                <p class="sidebar-section-label">Students</p>
                <ul class="sidebar-nav">
                    <li>
                        <a class="@(currentController == "Students" && currentAction == "List" ? "active" : "")"
                           asp-controller="Students" asp-action="List">
                            <span class="nav-icon"><i class="fa-solid fa-users"></i></span>
                            All Students
                        </a>
                    </li>
                    <li>
                        <a class="@(currentController == "Students" && currentAction == "Add" ? "active" : "")"
                           asp-controller="Students" asp-action="Add">
                            <span class="nav-icon"><i class="fa-solid fa-user-plus"></i></span>
                            Add Student
                        </a>
                    </li>
                </ul>

                <hr class="sidebar-divider">

                <p class="sidebar-section-label">Lessons</p>
                <ul class="sidebar-nav">
                    <li>
                        <a class="@(currentController == "Lessons" && currentAction == "Create" ? "active" : "")"
                           asp-controller="Lessons" asp-action="Create">
                            <span class="nav-icon"><i class="fa-solid fa-plus"></i></span>
                            Add Lesson
                        </a>
                    </li>
                    <li>
                        <a class="@(currentController == "Lessons" && currentAction == "Analytics" ? "active" : "")"
                           asp-controller="Lessons" asp-action="Analytics">
                            <span class="nav-icon"><i class="fa-solid fa-chart-bar"></i></span>
                            Analytics
                        </a>
                    </li>
                </ul>

                <hr class="sidebar-divider">

                <p class="sidebar-section-label">Community</p>
                <ul class="sidebar-nav">
                    <li>
                        <a class="@(currentController == "Chat" && currentAction == "Index" ? "active" : "")"
                           asp-controller="Chat" asp-action="Index">
                            <span class="nav-icon"><i class="fa-solid fa-comments"></i></span>
                            Chat Room
                        </a>
                    </li>
                    <li>
                        <a class="@(currentController == "AdminNotification" && currentAction == "Index" ? "active" : "")"
                           asp-controller="AdminNotification" asp-action="Index">
                            <span class="nav-icon"><i class="fa-solid fa-bell"></i></span>
                            Notifications
                        </a>
                    </li>
                </ul>

            </aside>

            <main class="sp-main--full">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                        <i class="fa-solid fa-circle-check me-2"></i>
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </main>
        }
        else
        {
          
            <main class="sp-main--full">
                @RenderBody()
            </main>
        }

    </div>

    <footer class="sp-footer">
        © @DateTime.Now.Year Student Portal &mdash; All rights reserved
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

